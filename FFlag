local currentTier = nil

local function applyTier(index)
    if currentTier == index then return end
    currentTier = index
    for k, v in pairs(tiers[index]) do
        setFlag(k, v)
        RunService.RenderStepped:Wait()
    end
    setFlag("FIntDebugTextureManagerSkipMips", "8")
    setFlag("FFlagDisablePostFx", "true")
end

applyTier(2)

local frameCount    = 0
local timeAccum     = 0
local SAMPLE_TIME   = 2.5
local LOW_THRESHOLD = 45
local HIGH_THRESHOLD= 75
local LOW_STREAK    = 3
local HIGH_STREAK   = 6

local lowStreak, highStreak = 0, 0

RunService.RenderStepped:Connect(function(dt)
    frameCount = frameCount + 1
    timeAccum  = timeAccum + dt

    if timeAccum < SAMPLE_TIME then return end

    local fps = frameCount / timeAccum
    frameCount = 0
    timeAccum  = 0

    if fps < LOW_THRESHOLD then
        lowStreak  = lowStreak + 1
        highStreak = 0
    elseif fps > HIGH_THRESHOLD then
        highStreak = highStreak + 1
        lowStreak  = 0
    else
        lowStreak, highStreak = 0, 0
    end

    if lowStreak >= LOW_STREAK and currentTier > 1 then
        applyTier(currentTier - 1)
        lowStreak = 0
    end

    if highStreak >= HIGH_STREAK and currentTier < 3 then
        applyTier(currentTier + 1)
        highStreak = 0
    end
end)
