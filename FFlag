if not setfflag then return end

local RunService = game:GetService("RunService")

local function stripPrefix(name)
    name = name:gsub("^DFInt", "")
    name = name:gsub("^DFFlag", "")
    name = name:gsub("^FFlag", "")
    name = name:gsub("^FInt", "")
    name = name:gsub("^FString", "")
    name = name:gsub("^FLog", "")
    return name
end

local function setFlag(k, v)
    pcall(function() setfflag(stripPrefix(k), v) end)
    pcall(function() setfflag(k, v) end)
end

